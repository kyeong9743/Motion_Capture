# =============================================================================
# RTX 5070 (Blackwell / sm_120)에서 SMPLest-X (손/얼굴 전신 추정) 실행
# -----------------------------------------------------------------------------
# 업스트림은 torch 1.12 + cu113 (conda)을 고정한다. Blackwell에서 실행되지 않으므로
# CUDA 12.8 + PyTorch 2.7로 오버라이드한다 — Dockerfile.gvhmr과 동일한 포팅 레시피.
# SMPLest-X에는 mmcv/mmdet/mmpose가 없어(SMPLer-X와 달리) 단순하다.
# 렌더링 의존성(pyrender/osmesa)은 설치되지만 추출 스크립트에서는 사용하지 않는다.
# =============================================================================
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3.10-dev python3-pip \
      git wget curl ffmpeg build-essential \
      libgl1 libglib2.0-0 libosmesa6 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python

RUN python -m pip install --upgrade "pip" "setuptools==69.5.1" "wheel"

WORKDIR /app

# 1) Blackwell용 PyTorch (cu128)
RUN pip install torch==2.7.1 torchvision==0.22.1 \
      --index-url https://download.pytorch.org/whl/cu128

# 2) numpy 낮은 버전 고정 (chumpy가 >=1.24에서 제거된 np.bool 별칭을 사용한다)
RUN pip install "numpy==1.23.5"

# 3) chumpy: setup.py의 `import pip`가 빌드 격리 환경에서 실패한다
RUN pip install --no-build-isolation "git+https://github.com/mattloper/chumpy.git"

# 4) SMPLest-X 나머지 의존성 (torch/numpy/chumpy는 이미 처리됨)
COPY SMPLest-X/requirements.txt /tmp/requirements.txt
RUN grep -viE '^(numpy==|chumpy)' /tmp/requirements.txt > /tmp/req.trimmed.txt && \
    pip install -r /tmp/req.trimmed.txt

# SMPLest-X 소스는 /app/SMPLest-X에 바인드 마운트된다 (compose 참조)
WORKDIR /app/SMPLest-X
CMD ["sleep", "infinity"]
