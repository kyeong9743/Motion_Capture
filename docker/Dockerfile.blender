# =============================================================================
# SMPL-X 애니메이션 -> FBX/GLB 베이킹을 위한 헤드리스 Blender.
# `bpy` PyPI 모듈(Blender를 Python 모듈로 사용)을 쓴다 — GUI나 X 서버 불필요.
# bpy 4.2 휠은 Python 3.11을 요구한다.
# =============================================================================
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# bpy 휠이 링크하는 런타임 라이브러리 (헤드리스에서도 필요)
RUN apt-get update && apt-get install -y --no-install-recommends \
      libxrender1 libxi6 libxxf86vm1 libxfixes3 libxkbcommon0 \
      libsm6 libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install "bpy==4.2.0" "numpy<2"

WORKDIR /work
CMD ["python", "--version"]
